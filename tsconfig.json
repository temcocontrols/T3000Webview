{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      /* Vue path alias */
      "@/*": ["src/*"],
      /* Legacy paths */
      "@t3-vue/*": ["src/t3-vue/*"],
      "@t3-react/*": ["src/t3-react/*"],
      "@common/*": ["src/lib/*"],
      "src/*": ["src/*"],
      "app/*": ["*"],
      "components/*": ["src/components/*"],
      "layouts/*": ["src/layouts/*"],
      "pages/*": ["src/pages/*"],
      "assets/*": ["src/assets/*"],
      "boot/*": ["src/boot/*"],
      "stores/*": ["src/stores/*"],

      /* New feature-based structure */
      "@app/*": ["src/t3-react/app/*"],
      "@features/*": ["src/t3-react/features/*"],
      "@shared/*": ["src/t3-react/shared/*"],
      "@layout/*": ["src/t3-react/layout/*"],
      "@store/*": ["src/t3-react/store/*"],
      "@theme/*": ["src/t3-react/theme/*"],

      /* Multi-platform architecture */
      "@t3-shared/*": ["src/shared/*"],
      "@t3-mobile/*": ["src/t3-mobile/*"],

      /* EEZ Studio fork (junction at src/lib/t3-eez-studio) */
      "eez-studio-shared/*": ["src/lib/t3-eez-studio/eez-studio-shared/*"],
      "eez-studio-shared": ["src/lib/t3-eez-studio/eez-studio-shared"],
      "eez-studio-ui/*": ["src/lib/t3-eez-studio/eez-studio-ui/*"],
      "eez-studio-types": ["src/lib/t3-eez-studio/eez-studio-types"],
      "eez-studio-types/*": ["src/lib/t3-eez-studio/eez-studio-types/*"],
      "eez-studio-web-entry": ["src/lib/t3-eez-studio/eez-studio-web-entry.tsx"],
      "db-services/*": ["src/lib/t3-eez-studio/db-services/*"],
      "home/*": ["src/lib/t3-eez-studio/home/*"],
      "instrument/*": ["src/lib/t3-eez-studio/instrument/*"],
      "project-editor/*": ["src/lib/t3-eez-studio/project-editor/*"],
      "main/*": ["src/lib/t3-eez-studio/main/*"],
      "notebook/*": ["src/lib/t3-eez-studio/notebook/*"],
      "shortcuts/*": ["src/lib/t3-eez-studio/shortcuts/*"],
      "basic-measurements/*": ["src/lib/t3-eez-studio/basic-measurements/*"],
      "db-services/*": ["src/lib/t3-eez-studio/db-services/*"],
      "pdf-services/*": ["src/lib/t3-eez-studio/pdf-services/*"]
    },

    /* Experimental */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".quasar",
    "api"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
