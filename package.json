  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 quasar build",
    "build:analyze": "cross-env NODE_OPTIONS=--max-old-space-size=8192 ANALYZE=true quasar build",
    "client-dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 quasar dev",
    "api-dev": "cd api && cargo watch -x \"run --example run_server\"",
    "api": "cd api && cargo run --example run_server",
    "api-t3000-debug": "cd api && cargo build --example run_server && copy .\\target\\debug\\examples\\run_server.exe \"C:\\QN\\temcocontrols\\T3000_Building_Automation_System\\T3000 Output\\Debug\\\" && powershell -Command \"[Console]::OutputEncoding = [Text.Encoding]::UTF8; & 'C:\\QN\\temcocontrols\\T3000_Building_Automation_System\\T3000 Output\\Debug\\run_server.exe' 2>&1 | Tee-Object 'C:\\QN\\temcocontrols\\T3Copilot\\Debug-Log\\api-t3000-debug-server.log'\"",
    "api-t3000-build": "cd api && cargo build --example run_server && copy .\\target\\debug\\examples\\run_server.exe \"C:\\QN\\temcocontrols\\T3000_Building_Automation_System\\T3000 Output\\Debug\\\"",
    "dev": "concurrently \"npm run api-dev\" \"npm run client-dev\"",
    "deploy:t3000": "node scripts/deploy-to-t3000.bat",
    "deploy:t3000:build": "npm run build:webview && npm run deploy:t3000",
    "copy-manifest": "node -e \"const fs=require('fs'); const pkg=require('./package.json'); fs.writeFileSync('./dist/version.json', JSON.stringify({version: pkg.version, buildTime: Date.now()}))\"",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit:ui": "vitest --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run"
  },
